context commerce.baskets

type CustomerId = opaque String where NonEmpty

type Sku = opaque String where NonEmpty

type Quantity = Int where InRange(1, 100)

type BasketSnapshot = {
	lineCount: Int,
	revision: Int,
	note: Option[String],
}

agent Basket {
	key owner: CustomerId

	store lines: Map[Sku, Quantity]
	store note: Cell[Option[String]]
	store revision: Cell[Int]

	on call setLine(sku: Sku, quantity: Quantity) -> Effect[()] {
		do lines.put(sku, quantity)
		do revision.update((n) => n + 1)
	}

	on call leaveNote(message: String) -> Effect[()] {
		note := Some(message)
	}

	on call snapshot() -> Effect[BasketSnapshot] {
		let lineCount <- lines.size()
		BasketSnapshot { lineCount: lineCount, revision: revision, note: note }
	}
}

service setBasketLine {
	on call(owner: CustomerId, sku: Sku, quantity: Quantity) -> Effect[()] {
		do Basket(owner).setLine(sku, quantity)
	}
}

service basketSnapshot {
	on call(owner: CustomerId) -> Effect[BasketSnapshot] {
		let basket = Basket(owner)
		let view <- basket.snapshot()
		view
	}
}

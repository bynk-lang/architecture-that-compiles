context commerce.orders

uses commerce.values
consumes commerce.inventory as Inventory
consumes commerce.payments as Payments
exports transparent { OrderError, OrderView }

actor Customer {
	auth = Bearer(
		secret = "AUTH_JWT_SECRET"
	),
	identity = CustomerId
}

type OrderStatus = enum { Draft, Placed, Paid, Rejected }

type OrderError = enum { OutOfStock, PaymentFailed, AlreadySubmitted }

type OrderView = { status: OrderStatus, reserved: Bool }

agent Order {
	key id: OrderId

	store owner: Cell[Option[CustomerId]]
	store status: Cell[OrderStatus] = Draft
	store reserved: Cell[Bool]
	store paymentRef: Cell[Option[String]]

	invariant paid_has_payment_ref:
		status == Paid implies paymentRef.isSome()

	invariant paid_has_reservation:
		status == Paid implies reserved

	invariant rejected_holds_no_stock:
		status == Rejected implies reserved == false

	transition paid_is_terminal:
		old.status is Paid implies new.status is Paid

	on call begin(customer: CustomerId) -> Effect[Result[(), OrderError]] {
		match status {
			Draft => {
				owner := Some(customer)
				status := Placed
				Ok(())
			},
			Placed => Err(AlreadySubmitted),
			Paid => Err(AlreadySubmitted),
			Rejected => Err(AlreadySubmitted),
		}
	}

	on call markReserved() -> Effect[()] {
		reserved := true
	}

	on call reject() -> Effect[()] {
		status := Rejected
		reserved := false
	}

	on call markPaid(reference: String) -> Effect[OrderView] {
		paymentRef := Some(reference)
		status := Paid
		OrderView { status: status, reserved: reserved }
	}

	on call viewFor(customer: CustomerId) -> Effect[Option[OrderView]] {
		match owner {
			Some(placedBy) if placedBy == customer => Some(OrderView {
				status: status,
				reserved: reserved,
			}),
			_ => None,
		}
	}
}

service api from http {
	on POST("/orders/:id") (
		id: OrderId,
		body: OrderRequest
	) -> Effect[HttpResult[OrderView]] by customer: Customer {
		let started <- Order(id).begin(customer.identity)
		match started {
			Err(_) => Conflict("order was already submitted"),
			Ok(_) => {
				let held <- Inventory.reserve(body.sku, body.quantity)
				match held {
					Err(_) => {
						do Order(id).reject()
						Conflict("stock is unavailable")
					},
					Ok(_) => {
						do Order(id).markReserved()
						let charged <- Payments.charge(
							customer.identity,
							body.cents
						)
						match charged {
							Err(failure) => {
								do Inventory.release(body.sku, body.quantity)
								do Order(id).reject()
								match failure {
									Declined => UnprocessableEntity(
										"payment was declined"
									),
									Fraudulent => Forbidden,
									ProviderUnavailable => ServiceUnavailable(
										"payment provider unavailable"
									),
								}
							},
							Ok(reference) => {
								let order <- Order(id).markPaid(reference)
								Created(order)
							},
						}
					},
				}
			},
		}
	}

	on GET("/orders/:id") (
		id: OrderId
	) -> Effect[HttpResult[OrderView]] by customer: Customer {
		let order <- Order(id).viewFor(customer.identity)
		match order {
			Some(view) => Ok(view),
			None => NotFound,
		}
	}
}
